# Copy this file to .env and replace every placeholder before starting.

WAHA_IMAGE=devlikeapro/waha:2026.9.2
WAHA_PORT=3000

WAHA_API_KEY=replace-with-a-long-random-api-key

WAHA_DASHBOARD_ENABLED=true
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace-with-a-long-random-dashboard-password

WHATSAPP_SWAGGER_ENABLED=true
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=replace-with-a-long-random-swagger-password

WAHA_PRINT_QR=false
