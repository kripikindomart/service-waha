{
  "name": "service-waha-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run start:dev",
    "dev:web": "npm --workspace apps/web run dev",
    "db:generate": "npm --workspace packages/database run generate",
    "db:migrate": "npm --workspace packages/database run migrate",
    "db:seed": "npm --workspace apps/api run seed"
  },
  "devDependencies": {
    "fast-check": "^4.10.2"
  }
}
